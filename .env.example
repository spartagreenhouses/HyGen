# Copy to .env.local to change LIVE data settings (see src/config/liveConfig.ts)
# mock | websocket | mqtt
VITE_LIVE_TRANSPORT=mock
VITE_WS_URL=ws://localhost:8787
VITE_MQTT_URL=ws://localhost:8083/mqtt
VITE_MQTT_USER=
VITE_MQTT_PASS=
VITE_TOPIC_PREFIX=plant
# SAFETY: keep false until a reviewed backend authorisation layer exists
VITE_LIVE_CONTROL=false
