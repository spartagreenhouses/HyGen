    "mock:ws": "tsx server/mockTelemetryServer.ts",
    "models:compress": "node tools/compressModels.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.1.0",
    "@fontsource/ibm-plex-sans": "^5.1.0",
