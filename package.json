{
  "name": "solar-h2-digital-twin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Solar Hydrogen Energy Storage System — interactive 3D digital twin, simulation and SCADA web app",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
